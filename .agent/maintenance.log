+    pub fn matmul(
+        &self,
+        x: &[f32],
+        out: &mut [f32],
+        batch: usize,
+        scratch: &mut [f32],
+    ) -> Result<()> {
+        if batch == 0 {
+            return Ok(());
+        }
+        debug_assert_eq!(x.len(), batch * self.cols);
+        debug_assert_eq!(out.len(), batch * self.rows);
+        let scratch = &mut scratch[..self.cols];
+
