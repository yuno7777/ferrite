+        Value::U8(x) => w.write_all(&[*x])?,
+        Value::I8(x) => w.write_all(&x.to_le_bytes())?,
+        Value::U16(x) => prim!(x),
+        Value::I16(x) => prim!(x),
+        Value::U32(x) => prim!(x),
+        Value::I32(x) => prim!(x),
+        Value::F32(x) => prim!(x),
