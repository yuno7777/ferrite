++pub fn f32_to_f16(val: f32) -> u16 {
++    let bits = val.to_bits();
++    let sign = ((bits >> 16) & 0x8000) as u16;
++    let exp32 = ((bits >> 23) & 0xFF) as i32;
++    let mant32 = bits & 0x007F_FFFF;
++
