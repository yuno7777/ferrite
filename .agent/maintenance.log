+fn cmd_info(args: &[String]) -> std::io::Result<()> {
+    let show_tensors = args.iter().any(|a| a == "-t" || a == "--tensors");
+    let query = args.iter().find(|a| !a.starts_with('-')).ok_or_else(|| {
