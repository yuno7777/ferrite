+-/// Convert a GGUF file into a new GGUF file with 2D weight tensors quantized to `target_ty`.
+-pub fn quantize_model(src_path: &Path, dst_path: &Path, target_ty: GgmlType) -> Result<()> {
+-    let src = Gguf::open(src_path)?;
+-
+-    let mut out = Vec::new();
+-    out.extend_from_slice(b"GGUF");
+-    out.extend_from_slice(&src.version.to_le_bytes());
+-    out.extend_from_slice(&(src.tensors.len() as u64).to_le_bytes());
+-    out.extend_from_slice(&(src.metadata.len() as u64).to_le_bytes());
+-
+-    // Copy metadata verbatim
+-    for (key, value) in &src.metadata {
