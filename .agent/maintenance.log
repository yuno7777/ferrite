++    let input = Gguf::open(&src).unwrap();
++    let output = Gguf::open(&dst).unwrap();
++    assert_eq!(
++        input.tensor("weight").unwrap().ty,
++        output.tensor("weight").unwrap().ty
++    );
++    assert_eq!(
++        input.tensor_bytes(input.tensor("weight").unwrap()).unwrap(),
++        output
++            .tensor_bytes(output.tensor("weight").unwrap())
++            .unwrap()
++    );
++    fs::remove_file(src).unwrap();
++    fs::remove_file(dst).unwrap();
++}
