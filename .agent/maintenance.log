+++    fn uniform_distribution_cross_entropy_equals_log_vocab() {
+++        let vocab = 100;
+++        let logits = vec![1.5f32; vocab]; // all equal
+++        let target = 42;
+++        let loss = cross_entropy_loss(&logits, target).expect("loss");
+++        let expected = (vocab as f64).ln();
