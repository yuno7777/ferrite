[package]
name = "ferrite"
version = "0.1.0"
edition = "2021"
rust-version = "1.82"
description = "Pure-Rust LLM inference engine. Reads GGUF, no dependencies."
repository = "https://github.com/yuno7777/ferrite"
license = "MIT"
keywords = ["llm", "inference", "gguf", "quantization", "tokenizer"]
categories = ["science", "command-line-utilities"]
readme = "README.md"
exclude = ["*.gguf"]

[lib]
name = "ferrite"
path = "src/lib.rs"

[[bin]]
name = "ferrite"
path = "src/main.rs"

# No dependencies. Not "few" — none. `cargo tree` prints one line.
[dependencies]

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1

