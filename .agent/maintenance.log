            let b: Vec<f32> = (0..len).map(|i| (i * 2) as f32).collect();
            let expected: f32 = a.iter().zip(&b).map(|(x, y)| x * y).sum();
            assert!(close(dot(&a, &b), expected), "length {len}");
        }
    }

