+-/// Convert a GGUF file into a new GGUF file with 2D weight tensors quantized to `target_ty`.
+-pub fn quantize_model(src_path: &Path, dst_path: &Path, target_ty: GgmlType) -> Result<()> {
+-    let src = Gguf::open(src_path)?;
+-
