+                quant::dequantize(self.ty, row, scratch)?;
+                for b in 0..batch {
+                    let x_tok = &x[b * self.cols..(b + 1) * self.cols];
+                    out[b * self.rows + r] = ops::dot(scratch, x_tok);
+                }
+            }
+        }
+        Ok(())
+    }
