++use std::fs;
++use std::path::PathBuf;
++use ferrite::gguf::Gguf;
++use ferrite::quant::quantize::quantize_file;
++use ferrite::synth::Builder;
++use ferrite::{GgmlType, Value};
++
++fn path(name: &str) -> PathBuf { std::env::temp_dir().join(format!("ferrite_quantize_{name}_{}.gguf", std::process::id())) }
++
++#[test]
++fn quantize_preserves_metadata_and_writes_readable_output() {
++    let src = path("src"); let dst = path("dst");
++    let mut floats = Vec::new();
++    for i in 0..256 { floats.extend_from_slice(&((i as f32 - 128.0) / 31.0).to_le_bytes()); }
++    Builder::new().meta("general.architecture", Value::String("test".into()))
++        .tensor("weight", &[256], GgmlType::F32, floats).write(&src).unwrap();
++    quantize_file(&src, &dst, GgmlType::Q4_K).unwrap();
++    let output = Gguf::open(&dst).unwrap();
++    let tensor = output.tensor("weight").unwrap();
++    assert_eq!(tensor.ty, GgmlType::Q4_K);
++    assert_eq!(output.arch(), Some("test"));
++    assert_eq!(tensor.byte_len, Some(144));
++    let decoded = ferrite::quant::dequantize_to_vec(tensor.ty, output.tensor_bytes(tensor).unwrap(), 256).unwrap();
++    assert!(decoded.iter().all(|x| x.is_finite()));
++    fs::remove_file(src).unwrap(); fs::remove_file(dst).unwrap();
++}
++
++#[test]
++fn quantize_leaves_non_float_tensors_unchanged() {
++    let src = path("copy_src"); let dst = path("copy_dst");
++    Builder::new().tensor("weight", &[32], GgmlType::Q8_0, vec![0; 34]).write(&src).unwrap();
++    quantize_file(&src, &dst, GgmlType::Q4_0).unwrap();
++    let input = Gguf::open(&src).unwrap(); let output = Gguf::open(&dst).unwrap();
++    assert_eq!(input.tensor("weight").unwrap().ty, output.tensor("weight").unwrap().ty);
++    assert_eq!(input.tensor_bytes(input.tensor("weight").unwrap()).unwrap(), output.tensor_bytes(output.tensor("weight").unwrap()).unwrap());
++    fs::remove_file(src).unwrap(); fs::remove_file(dst).unwrap();
++}
+
