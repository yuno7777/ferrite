+fn write_value(w: &mut impl Write, v: &Value) -> io::Result<()> {
+    macro_rules! prim {
+        ($x:expr) => {
+            w.write_all(&$x.to_le_bytes())?
+        };
+    }
+    match v {
+        Value::U8(x) => w.write_all(&[*x])?,
+        Value::I8(x) => w.write_all(&x.to_le_bytes())?,
+        Value::U16(x) => prim!(x),
+        Value::I16(x) => prim!(x),
+        Value::U32(x) => prim!(x),
+        Value::I32(x) => prim!(x),
+        Value::F32(x) => prim!(x),
