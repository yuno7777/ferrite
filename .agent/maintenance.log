++++    assert_eq!(q4_gguf.tensors[0].ty, GgmlType::Q4_0);
++++
++++    let q4_bytes = q4_gguf.tensor_bytes(&q4_gguf.tensors[0]).unwrap();
++++    let q4_reconstructed = dequantize_to_vec(GgmlType::Q4_0, q4_bytes, num_elements).unwrap();
