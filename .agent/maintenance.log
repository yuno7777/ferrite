++#[test]
++fn quantize_preserves_metadata_and_writes_readable_output() {
++    let src = path("src");
++    let dst = path("dst");
++    let expected: Vec<f32> = (0..256).map(|i| (i as f32 - 128.0) / 31.0).collect();
++    let mut floats = Vec::new();
++    for value in &expected {
++        floats.extend_from_slice(&value.to_le_bytes());
++    }
++    Builder::new()
++        .meta("general.architecture", Value::String("test".into()))
++        .tensor("weight", &[256], GgmlType::F32, floats)
++        .write(&src)
++        .unwrap();
++    quantize_file(&src, &dst, GgmlType::Q4_K).unwrap();
++    let output = Gguf::open(&dst).unwrap();
++    let tensor = output.tensor("weight").unwrap();
++    assert_eq!(tensor.ty, GgmlType::Q4_K);
++    assert_eq!(output.arch(), Some("test"));
++    assert_eq!(tensor.byte_len, Some(144));
++    let decoded =
++        ferrite::quant::dequantize_to_vec(tensor.ty, output.tensor_bytes(tensor).unwrap(), 256)
++            .unwrap();
++    assert!(decoded.iter().all(|x| x.is_finite()));
++    let max_error = decoded
++        .iter()
++        .zip(expected)
++        .map(|(actual, expected)| (actual - expected).abs())
++        .fold(0.0f32, f32::max);
++    assert!(max_error < 0.1, "unexpected Q4_K error {max_error}");
++    fs::remove_file(src).unwrap();
++    fs::remove_file(dst).unwrap();
++}
++
++#[test]
