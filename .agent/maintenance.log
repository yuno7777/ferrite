pub enum Value {
    U8(u8),
    I8(i8),
    U16(u16),
    I16(i16),
    U32(u32),
    I32(i32),
    F32(f32),
    Bool(bool),
//! Integration tests for zero-copy dynamic LoRA adapter application.

use std::fs;
