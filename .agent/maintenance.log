++++        )
++++        .tensor(
++++            "blk.0.attn_q.weight",
++++            GgmlType::F32,
++++            &[DIM, DIM],
++++            &bytes(&identity(DIM)),
++++        )
++++        .tensor(
++++            "blk.0.attn_k.weight",
++++            GgmlType::F32,
++++            &[DIM, DIM],
++++            &bytes(&identity(DIM)),
++++        )
++++        .tensor(
++++            "blk.0.attn_v.weight",
++++            GgmlType::F32,
++++            &[DIM, DIM],
++++            &bytes(&identity(DIM)),
++++        )
++++        .tensor(
++++            "blk.0.attn_output.weight",
++++            GgmlType::F32,
++++            &[DIM, DIM],
++++            &bytes(&identity(DIM)),
++++        )
++++        .tensor(
++++            "blk.0.ffn_norm.weight",
++++            GgmlType::F32,
++++            &[DIM],
++++            &bytes(&[1.0; DIM]),
++++        )
++++        .tensor(
++++            "blk.0.ffn_gate.weight",
++++            GgmlType::F32,
++++            &[DIM, FFN],
