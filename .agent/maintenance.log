+                let q_tok = &q_batch[b * (c.heads * head_dim)..(b + 1) * (c.heads * head_dim)];
+                let xb_tok = &mut xb_batch[b * c.embedding..(b + 1) * c.embedding];
+
+                for head in 0..c.heads {
