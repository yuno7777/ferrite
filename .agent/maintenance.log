+fn write_value(w: &mut impl Write, v: &Value) -> io::Result<()> {
+    macro_rules! prim {
+        ($x:expr) => {
+            w.write_all(&$x.to_le_bytes())?
+        };
+    }
+    match v {
+        Value::U8(x) => w.write_all(&[*x])?,
+        Value::I8(x) => w.write_all(&x.to_le_bytes())?,
+        Value::U16(x) => prim!(x),
+        Value::I16(x) => prim!(x),
+        Value::U32(x) => prim!(x),
+        Value::I32(x) => prim!(x),
+        Value::F32(x) => prim!(x),
+        Value::U64(x) => prim!(x),
+        Value::I64(x) => prim!(x),
+        Value::F64(x) => prim!(x),
+        Value::Bool(x) => w.write_all(&[*x as u8])?,
+        Value::String(s) => write_string(w, s)?,
+        Value::Array(items) => {
+            let ty = items.first().map(Value::type_id).unwrap_or(4);
+            w.write_all(&ty.to_le_bytes())?;
+            w.write_all(&(items.len() as u64).to_le_bytes())?;
+            for item in items {
+                write_value(w, item)?;
+            }
         }
     }
+    Ok(())
+}
+fn type_id(t: GgmlType) -> u32 {
+    match t {
+        GgmlType::F32 => 0,
+        GgmlType::F16 => 1,
+        GgmlType::Q4_0 => 2,
+        GgmlType::Q4_1 => 3,
+        GgmlType::Q5_0 => 6,
+        GgmlType::Q5_1 => 7,
+        GgmlType::Q8_0 => 8,
+        GgmlType::Q8_1 => 9,
+        GgmlType::Q2_K => 10,
+        GgmlType::Q3_K => 11,
+        GgmlType::Q4_K => 12,
+        GgmlType::Q5_K => 13,
+        GgmlType::Q6_K => 14,
+        GgmlType::Q8_K => 15,
+        GgmlType::I8 => 24,
+        GgmlType::I16 => 25,
+        GgmlType::I32 => 26,
+        GgmlType::I64 => 27,
+        GgmlType::F64 => 28,
+        GgmlType::BF16 => 30,
+        GgmlType::Other(id) => id,
+    }
 }
