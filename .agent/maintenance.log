+fn cmd_quantize(args: &[String]) -> std::io::Result<()> {
+    if args.len() != 3 {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "usage: ferrite quantize <src.gguf> <dst.gguf> <Q8_0|Q4_0|Q4_K>"));
+    }
+    let target = match args[2].to_ascii_uppercase().as_str() {
+        "Q8_0" => ferrite::GgmlType::Q8_0,
+        "Q4_0" => ferrite::GgmlType::Q4_0,
+        "Q4_K" => ferrite::GgmlType::Q4_K,
+        _ => return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "quantization type must be Q8_0, Q4_0, or Q4_K")),
+    };
+    ferrite::quant::quantize::quantize_file(std::path::Path::new(&args[0]), std::path::Path::new(&args[1]), target)
