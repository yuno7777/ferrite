        "{:<26} {:>7} {:>10} {:>10} {:>10} {:>8} {:>8}",
        "shape", "type", "reference", "fused", "int8", "best", "GB/s"
    );

    for (label, cols, rows) in SHAPES {
        for ty in TYPES {
            let elements = cols * rows;
            let data = bytes_for(ty, elements);
