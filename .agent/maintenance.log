+/// Allocating form, for one-off inspection.
+pub fn dequantize_to_vec(ty: GgmlType, bytes: &[u8], elements: usize) -> Result<Vec<f32>> {
+    let mut out = vec![0.0; elements];
+    dequantize(ty, bytes, &mut out)?;
+    Ok(out)
+}
