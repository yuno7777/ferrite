+-/// Quantize a single 32-element slice into a 34-byte `Q8_0` block.
+-pub fn quantize_q8_0_block(src: &[f32; 32], out: &mut [u8; 34]) {
+-    let amax = src.iter().fold(0.0f32, |acc, &v| acc.max(v.abs()));
+-    let scale = amax / 127.0;
+-    half::write_f16(&mut out[0..2], scale);
+-
+-    let inv = if scale > 0.0 { 1.0 / scale } else { 0.0 };
+-    for (i, &val) in src.iter().enumerate() {
+-        let q = (val * inv).round().clamp(-127.0, 127.0) as i8;
+-        out[2 + i] = q as u8;
+-    }
+-}
+-
+-/// Quantize a single 32-element slice into an 18-byte `Q4_0` block.
+-pub fn quantize_q4_0_block(src: &[f32; 32], out: &mut [u8; 18]) {
+-    let amax = src.iter().fold(0.0f32, |acc, &v| acc.max(v.abs()));
+-    let scale = amax / 8.0;
+-    half::write_f16(&mut out[0..2], scale);
+-
+-    let inv = if scale > 0.0 { 1.0 / scale } else { 0.0 };
+-    for j in 0..16 {
+-        let q0 = (src[j] * inv).round().clamp(-8.0, 7.0) as i32 + 8;
+-        let q1 = (src[j + 16] * inv).round().clamp(-8.0, 7.0) as i32 + 8;
+-        out[2 + j] = (q0 as u8 & 0x0F) | (((q1 as u8) & 0x0F) << 4);
+-    }
+-}
+-
+-/// Quantize an element slice of F32 floats into target format bytes.
+-pub fn quantize_f32_slice(target_ty: GgmlType, elements: &[f32]) -> Result<Vec<u8>> {
+-    let (block_elements, block_bytes) = target_ty
+-        .layout()
+-        .ok_or_else(|| Error::new(ErrorKind::Unsupported, format!("unsupported type {:?}", target_ty)))?;
+-
+-    if elements.len() % block_elements as usize != 0 {
+-        return Err(Error::new(
+-            ErrorKind::InvalidInput,
+-            format!(
+-                "element count {} is not divisible by block size {}",
+-                elements.len(),
+-                block_elements
+-            ),
+-        ));
+-    }
+-
+-    let num_blocks = elements.len() / block_elements as usize;
+-    let mut out = vec![0u8; num_blocks * block_bytes as usize];
+ 
+-    match target_ty {
+-        GgmlType::Q8_0 => {
+-            let mut block_in = [0.0f32; 32];
+-            let mut block_out = [0u8; 34];
+-            for (b, chunk) in elements.chunks_exact(32).enumerate() {
+-                block_in.copy_from_slice(chunk);
+-                quantize_q8_0_block(&block_in, &mut block_out);
+-                let out_offset = b * 34;
+-                out[out_offset..out_offset + 34].copy_from_slice(&block_out);
+-            }
+-        }
+-        GgmlType::Q4_0 => {
+-            let mut block_in = [0.0f32; 32];
+-            let mut block_out = [0u8; 18];
+-            for (b, chunk) in elements.chunks_exact(32).enumerate() {
+-                block_in.copy_from_slice(chunk);
+-                quantize_q4_0_block(&block_in, &mut block_out);
+-                let out_offset = b * 18;
+-                out[out_offset..out_offset + 18].copy_from_slice(&block_out);
+-            }
+-        }
+-        GgmlType::F16 => {
+-            for (i, &val) in elements.iter().enumerate() {
+-                half::write_f16(&mut out[i * 2..i * 2 + 2], val);
+-            }
+-        }
+-        GgmlType::F32 => {
+-            for (i, &val) in elements.iter().enumerate() {
+-                out[i * 4..i * 4 + 4].copy_from_slice(&val.to_le_bytes());
+-            }
+-        }
+-        other => {
+-            return Err(Error::new(
+-                ErrorKind::Unsupported,
+-                format!("quantization to {:?} is not implemented yet", other),
+-            ));
+-        }
+-    }
+-
+-    Ok(out)
+-}
