+        let last_b = n - 1;
+        let last_x = &x_batch[last_b * c.embedding..(last_b + 1) * c.embedding];
+        let last_xb = &mut xb_batch[..c.embedding];
+        ops::rms_norm(last_x, &self.output_norm, c.eps, last_xb);
